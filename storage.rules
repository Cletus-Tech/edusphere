rules_version = '2';

// ---------------------------------------------------------------------
// EduSphere — Cloud Storage Security Rules (Stage 1.2 template)
// Mirrors lib/core/constants/storage_paths.dart. Deploy via
// `firebase deploy --only storage`.
// ---------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Stage 3.6.3 fix — the previous version of this function checked
    // request.auth.token.role, an Auth custom claim that nothing in this
    // project (no Cloud Function) ever set, so it evaluated false for
    // every user, including superAdmin, and silently denied every
    // staff-gated upload (banners, notes, videos, learning_materials,
    // etc.). Storage Rules can read Firestore directly via
    // firestore.get()/firestore.exists() (cross-service Rules, GA since
    // 2022), so this now mirrors firestore.rules' hasRole()/isStaff()
    // exactly, off the same `users/{uid}.roles` array — no custom claim
    // or Cloud Function required. Per Firebase's docs, Storage Rules may
    // read at most 2 unique Firestore documents per evaluation; repeated
    // calls to this function within one request all hit the same
    // users/{uid} doc, which is cached, so this stays within that limit
    // no matter how many isStaffFirestore() calls a single rule chain
    // makes.
    function isStaffFirestore() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(
          ['admin', 'superAdmin', 'institutionAdmin', 'lecturer', 'teacher', 'contentCreator']
        );
    }

    // Stage 6.3 — stricter than isStaffFirestore(): the Creator Profile
    // is the app owner's personal CMS, not general course/institution
    // content, so it's gated to admin/superAdmin only, not the full
    // staff list. Mirrors firestore.rules' isAdmin() (superAdmin ||
    // admin) exactly, same cross-service firestore.get() approach and
    // same 2-unique-document-per-evaluation budget as isStaffFirestore()
    // above (both read the same cached users/{uid} doc).
    function isAdminFirestore() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(
          ['admin', 'superAdmin']
        );
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /avatars/{userId}.jpg {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /institutions/{allPaths=**} { allow read: if true; allow write: if isStaffFirestore(); }
    match /notes/{allPaths=**}        { allow read: if isSignedIn(); allow write: if isStaffFirestore(); }
    match /videos/{allPaths=**}       { allow read: if isSignedIn(); allow write: if isStaffFirestore(); }
    match /documents/{allPaths=**}    { allow read: if isSignedIn(); allow write: if isStaffFirestore(); }
    match /assignments/{allPaths=**}  { allow read: if isSignedIn(); allow write: if isStaffFirestore(); }
    // DEPRECATED — see StoragePaths' Stage 3.5 doc comment; kept
    // read-only-from-new-code during the migration to
    // learning_materials below.
    match /learning_content/{allPaths=**} { allow read: if isSignedIn(); allow write: if isStaffFirestore(); }

    // Stage 3.5 — Learning Materials Module (official system).
    match /learning_materials/{allPaths=**} { allow read: if isSignedIn(); allow write: if isStaffFirestore(); }
    match /images/{allPaths=**}       { allow read: if true; allow write: if isSignedIn(); }
    match /banners/{allPaths=**}      { allow read: if true; allow write: if isStaffFirestore(); }

    // Stage 6.3 — Creator Profile ("About the Owner") uploads. Public
    // read (public-facing About page, matches firestore.rules'
    // creator_* collections), admin-only write via isAdminFirestore().
    match /creator_profile/{allPaths=**} { allow read: if true; allow write: if isAdminFirestore(); }

    match /community/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /certificates/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaffFirestore();
      allow write: if isStaffFirestore();
    }

    match /downloads/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /marketplace/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isStaffFirestore();
    }
  }
}
